# Local development only (npm run dev + `docker compose up -d db`).
# These values are NOT used in production: packaging/mac/install.sh
# generates a separate, real .env with random secrets in
# ~/Library/Application Support/BoxPilot/ — it never reads or writes this
# file. Never put a real client's credentials in this file; it is committed
# to the repository.
DATABASE_URL="postgresql://boxpilot:boxpilot-local-dev@localhost:5433/boxpilot?schema=public"
SESSION_SECRET="local-dev-only-not-for-production-min-32-chars"
APP_URL="http://localhost:3000"
DEMO_ADMIN_EMAIL="admin@boxpilot.local"
DEMO_ADMIN_PASSWORD="local-dev-only"

# Used by docker-compose.yml when running the full stack (db + app) in Docker
# locally. docker-compose.yml requires all of these to be set (no silent
# fallback to a hardcoded password) — see the "Migrations Prisma" /
# "Configuration production" sections in README.md.
POSTGRES_USER="boxpilot"
POSTGRES_PASSWORD="boxpilot-local-dev"
POSTGRES_DB="boxpilot"
