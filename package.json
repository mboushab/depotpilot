    "@radix-ui/react-slot": "^1.1.0",
    "@react-pdf/renderer": "^4.1.6",
    "bcryptjs": "^2.4.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "date-fns-tz": "^3.2.0",
    "html-to-image": "^1.11.13",
    "jose": "^5.9.6",
    "lucide-react": "^0.468.0",
    "next": "^16.3.4",
    "pdfjs-dist": "^6.3.289",
    "react": "^19.0.0",
    "react-datepicker": "^9.1.0",
    "react-dom": "^19.0.0",
    "react-hook-form": "^7.53.2",
    "server-only": "^0.0.1",
    "sonner": "^2.0.8",
    "tailwind-merge": "^2.5.5",
    "zod": "^3.23.8"
